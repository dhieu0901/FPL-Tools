# Shared
APP_ENV=development
APP_TIMEZONE=Asia/Bangkok

# API
API_HOST=0.0.0.0
API_PORT=8000
API_SECRET_KEY=replace-with-a-long-random-secret
ADMIN_INITIAL_EMAIL=admin@example.com
ADMIN_INITIAL_PASSWORD=replace-before-production
DATABASE_URL=postgresql+psycopg://vmf:vmf@localhost:5432/vmf
FPL_BASE_URL=https://fantasy.premierleague.com/api
FPL_SYNC_ENABLED=false
FPL_REFRESH_INTERVAL_SECONDS=60
CORS_ORIGINS=http://localhost:3000

# Web
NEXT_PUBLIC_API_URL=http://localhost:8000/api
NEXT_PUBLIC_USE_MOCK_DATA=true

# PostgreSQL (local compose only)
POSTGRES_DB=vmf
POSTGRES_USER=vmf
POSTGRES_PASSWORD=vmf
