# Copy this file to .env for local development only.
# Never commit .env or replace these placeholders with real production secrets.

# API: Settings uses the VMF_ prefix.
VMF_ENVIRONMENT=development
VMF_API_PREFIX=/api
VMF_DATABASE_URL=postgresql+psycopg://vmf:vmf@localhost:5432/vmf
VMF_MIGRATION_DATABASE_URL=postgresql+psycopg://vmf:vmf@localhost:5432/vmf
VMF_DATABASE_USE_NULL_POOL=false
VMF_DATABASE_DISABLE_PREPARED_STATEMENTS=false
VMF_SQL_ECHO=false
VMF_ADMIN_API_KEY=replace-with-at-least-32-random-bytes
VMF_CORS_ORIGINS=["http://localhost:3000"]
VMF_FPL_BASE_URL=https://fantasy.premierleague.com/api
VMF_FPL_TIMEOUT_SECONDS=15
VMF_FPL_USER_AGENT=VMF-Fantasy-League/0.1
VMF_REFRESH_INTERVAL_SECONDS=60

# Vercel sends this value as Authorization: Bearer <secret> to cron routes.
# VMF_CRON_SECRET is also accepted as an alias on non-Vercel hosts; set only one.
CRON_SECRET=replace-with-at-least-32-random-bytes

# Web: these variables stay server-side in Next.js.
VMF_API_URL=http://localhost:8000/api
VMF_USE_MOCK_DATA=false
VMF_SEASON_ID=1
VMF_H2H_SCHEDULE_ID=1
VMF_SEASON_LABEL=2026/27
VMF_ADMIN_ACTOR=vmf-web
VMF_ADMIN_UI_USER=admin
VMF_ADMIN_UI_PASSWORD=replace-with-a-different-long-random-password

# PostgreSQL: local Docker Compose only.
POSTGRES_DB=vmf
POSTGRES_USER=vmf
POSTGRES_PASSWORD=vmf
# When changing the three values above, update this URL too and percent-encode
# reserved password characters such as @, :, / and %.
VMF_COMPOSE_DATABASE_URL=postgresql+psycopg://vmf:vmf@postgres:5432/vmf
