# URL server-side tới FastAPI, bao gồm prefix /api. Không thêm dấu / ở cuối.
VMF_API_URL=http://localhost:8000/api

# Mock bị tắt mặc định và không được dùng làm fallback khi API lỗi.
VMF_USE_MOCK_DATA=false

# ID bản ghi sau khi seed database.
VMF_SEASON_ID=1
VMF_H2H_SCHEDULE_ID=1
VMF_SEASON_LABEL=2026/27

# Chỉ cấu hình trong môi trường server/Vercel. Tuyệt đối không dùng prefix NEXT_PUBLIC_.
VMF_ADMIN_API_KEY=
VMF_ADMIN_ACTOR=vmf-web
VMF_ADMIN_UI_USER=admin
VMF_ADMIN_UI_PASSWORD=replace-with-at-least-16-random-characters

# Tương thích cấu hình Docker cũ; VMF_API_URL được ưu tiên.
NEXT_PUBLIC_API_URL=http://localhost:8000/api
NEXT_PUBLIC_USE_MOCK_DATA=false
