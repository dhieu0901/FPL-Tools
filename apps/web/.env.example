# Server-side URL of the FastAPI service, including the /api prefix.
# No trailing slash. In production this must be set: without it the site
# cannot load any data at all.
VMF_API_URL=http://localhost:8000/api

# Which season and which H2H schedule the site reads.
#
# VMF_H2H_SCHEDULE_ID is the one to check first if the H2H pages ever render
# empty: a schedule id that does not exist returns no fixtures rather than an
# error, so the page looks broken while everything else works. Production runs
# schedule 2 - schedule 1 was the placeholder generated before the real roster
# was imported.
VMF_SEASON_ID=1
VMF_H2H_SCHEDULE_ID=2
VMF_SEASON_LABEL=2026/27

# Admin credentials. Server-side only - never give any of these the
# NEXT_PUBLIC_ prefix, which would publish them to every visitor.
VMF_ADMIN_API_KEY=
VMF_ADMIN_ACTOR=vmf-web
VMF_ADMIN_UI_USER=admin
VMF_ADMIN_UI_PASSWORD=replace-with-at-least-16-random-characters

# Kept for the older Docker setup. VMF_API_URL takes precedence when both
# are present.
NEXT_PUBLIC_API_URL=http://localhost:8000/api
