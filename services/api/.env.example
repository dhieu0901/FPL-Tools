VMF_ENVIRONMENT=development
VMF_DATABASE_URL=postgresql+psycopg://vmf:change-me@localhost:5432/vmf
# Local/persistent defaults. On Vercel, use the Supabase transaction pooler
# (:6543), set USE_NULL_POOL=true and DISABLE_PREPARED_STATEMENTS=true.
VMF_DATABASE_USE_NULL_POOL=false
VMF_DATABASE_DISABLE_PREPARED_STATEMENTS=false
# Run Alembic outside Vercel with the Supabase session pooler (:5432) or direct URL:
# VMF_MIGRATION_DATABASE_URL=postgresql+psycopg://postgres.project-ref:change-me@region.pooler.supabase.com:5432/postgres
VMF_ADMIN_API_KEY=replace-with-at-least-32-random-characters
# Vercel sends CRON_SECRET as a Bearer token; VMF_CRON_SECRET is also accepted.
CRON_SECRET=replace-with-at-least-32-random-characters
VMF_CORS_ORIGINS=["http://localhost:3000"]
VMF_FPL_BASE_URL=https://fantasy.premierleague.com/api
VMF_FPL_TIMEOUT_SECONDS=15
